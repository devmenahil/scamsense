# ScamSense environment variables — placeholder names only.
# Copy to .env.local and fill in values. Never commit real secrets.
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# --- App ---
NEXT_PUBLIC_APP_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server-only secret key (sb_secret_... or legacy service_role) for gameplay writes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=

# --- PayPal (SANDBOX ONLY — the app refuses to start with any other environment) ---
# From developer.paypal.com → Apps & Credentials → Sandbox → your REST app. Never use Live credentials.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox app Client ID. Public by design (the browser SDK needs it); the server also uses it for OAuth.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox app Secret. Server only: never prefix it with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=

# --- Zapier (optional certificate email) ---
ZAPIER_CERTIFICATE_WEBHOOK_URL=
ZAPIER_WEBHOOK_SECRET=
